root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 90

[*.md]
# Два пробела в конце строки в Markdown означают перенос.
trim_trailing_whitespace = false
max_line_length = off

[*.{csv,tsv}]
max_line_length = off
trim_trailing_whitespace = false
insert_final_newline = unset
